generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────
/// Profile mirror of a Supabase `auth.users` row.
///
/// Supabase owns identity (credentials, email confirmation, OAuth); this table
/// exists so the domain tables below have a foreign key target inside the
/// schema Prisma manages. `id` holds the Supabase auth uuid verbatim, so no
/// column types had to change anywhere else when auth moved off Auth.js.
///
/// There is deliberately no FK to `auth.users`: that table lives in the `auth`
/// schema which Prisma does not manage, and a cross-schema FK would make every
/// migration fight the Supabase-managed schema. Rows are created lazily by
/// `getRequiredSession()` on a user's first authenticated request.
enum Plan {
  free
  pro
  household
}

model User {
  id    String  @id
  name  String?
  email String? @unique
  image String?
  /// No billing integration exists yet — this is set manually (DB/admin),
  /// never by the user themselves. See lib/plan.ts for what each tier gates.
  plan  Plan    @default(free)
  /// F13: opt-in weekly email digest (Resend). Off by default — sending
  /// unsolicited email isn't the default for a new signup.
  weeklyDigestEnabled Boolean @default(false)
  /// Onboarding checklist progress, e.g. {"account": true, "transaction": true}.
  /// Keys flip server-side the moment the underlying action happens (see
  /// lib/onboarding.ts) — never set directly by the client.
  onboardingSteps     Json    @default("{}")
  onboardingDismissed Boolean @default(false)

  financialAccounts   FinancialAccount[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  debts               Debt[]
  payoffScenarios     PayoffScenario[]
  loanScenarios       LoanScenario[]
  categorizationRules CategorizationRule[]
  ownedHouseholds       Household[]       @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]
  balanceSnapshots      BalanceSnapshot[]
  goals                 Goal[]
  holdings              Holding[]
  recurringSeries       RecurringSeries[]
  importMappings        ImportMapping[]
  plaidItems            PlaidItem[]

  createdAt DateTime @default(now())
}

// ─── FinFlow domain (Phase 1) ────────────────────────────────────────────
enum AccountType {
  checking
  savings
  cash
  credit_card
  auto_loan
  student_loan
  mortgage
  personal_loan
  investment
  other
}

model FinancialAccount {
  id                String      @id @default(cuid())
  userId            String
  name              String
  institution       String
  type              AccountType
  balance           Decimal     @db.Decimal(14, 2)
  includeInNetWorth Boolean     @default(true)
  archived          Boolean     @default(false)
  creditLimit       Decimal?    @db.Decimal(14, 2)
  apr               Decimal?    @db.Decimal(6, 4)
  minimumPayment    Decimal?    @db.Decimal(12, 2)
  dueDay            Int?
  originalBalance   Decimal?    @db.Decimal(14, 2)
  lastUpdated       DateTime    @default(now())
  /// R9.3: set when this account was created by (or linked to) a Plaid Item,
  /// rather than manually. Null for manual/CSV-only accounts.
  plaidItemDbId  String?
  plaidAccountId String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  debts        Debt[]
  balanceSnapshots BalanceSnapshot[]
  goals        Goal[]
  holdings     Holding[]
  plaidItem    PlaidItem?    @relation(fields: [plaidItemDbId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum PlaidItemStatus {
  active
  login_required
  error
}

/// R9.1-R9.5: one row per linked Plaid Item (one bank login can cover
/// several FinancialAccount rows). The access token is the one secret in
/// this app that's genuinely dangerous if leaked — it's AES-256-GCM
/// encrypted at rest (lib/plaidCrypto.ts) and never sent to the client, per
/// PRD §11. `cursor` drives /transactions/sync's incremental fetch — null
/// until the first sync, after which it's Plaid's opaque continuation token.
model PlaidItem {
  id                   String          @id @default(cuid())
  userId               String
  plaidItemId          String          @unique
  accessTokenEncrypted String
  institutionName      String?
  cursor               String?
  status               PlaidItemStatus @default(active)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]

  @@index([userId])
}

/// One row per account per day, written by the nightly snapshot-balances cron
/// (app/api/cron/snapshot-balances/route.ts). Powers the net-worth history
/// chart — `includeInNetWorth`/`archived` are read live off FinancialAccount
/// at query time, not duplicated here, so toggling either retroactively
/// reshapes history the same way the live net-worth widget already behaves.
model BalanceSnapshot {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  balance   Decimal  @db.Decimal(14, 2)
  asOf      DateTime @db.Date

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOf])
  @@index([userId, asOf])
}

enum CategoryKind {
  expense
  income
  transfer
}

model Category {
  id       String       @id @default(cuid())
  userId   String?
  name     String
  group    String
  icon     String
  color    String
  kind     CategoryKind @default(expense)
  archived Boolean      @default(false)
  parentId String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgetEntries BudgetEntry[]
  categorizationRules CategorizationRule[]

  @@index([userId])
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionSource {
  manual
  csv
  plaid
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  accountId    String
  categoryId   String?
  type         TransactionType
  amount       Decimal           @db.Decimal(14, 2)
  merchant     String
  description  String?
  date         DateTime          @db.Date
  postedDate   DateTime?         @db.Date
  notes        String?
  tags         String[]          @default([])
  recurring    Boolean           @default(false)
  cleared      Boolean           @default(true)
  source       TransactionSource @default(manual)
  importHash   String?
  /// R9.4: Plaid's own transaction_id — the identity /transactions/sync uses
  /// for added/modified/removed diffing. Separate from importHash (which
  /// still gets computed and checked for Plaid-sourced rows too, so a
  /// transaction imported via CSV before the account was linked to Plaid
  /// doesn't get duplicated once sync catches up to the same real charge).
  plaidTransactionId String? @unique
  createdAt    DateTime          @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])

  @@unique([userId, importHash])
  @@index([userId, date])
  @@index([accountId, date])
}

model Budget {
  id             String   @id @default(cuid())
  userId         String
  /// Set only when this budget is explicitly shared to the caller's household
  /// at creation time (opt-in — most budgets stay personal, householdId null).
  householdId    String?
  month          String   // 'YYYY-MM'
  expectedIncome Decimal  @db.Decimal(12, 2) @default(0)
  savingsTarget  Decimal  @db.Decimal(12, 2) @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting the household (e.g. because its owner's
  // account was deleted) must not delete OTHER members' budgets — it just
  // un-shares them back to personal, same as removing a single member does
  // in app/api/household/members/[userId]/route.ts.
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  entries   BudgetEntry[]

  @@unique([userId, month])
  @@index([householdId, month])
}

model BudgetEntry {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  budgeted   Decimal @db.Decimal(12, 2)
  rollover   Boolean @default(false)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
}

enum DebtType {
  credit_card
  auto_loan
  student_loan
  personal_loan
  mortgage
  medical
  bnpl
  other
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  accountId       String?
  name            String
  lender          String
  type            DebtType
  balance         Decimal  @db.Decimal(14, 2)
  originalBalance Decimal  @db.Decimal(14, 2)
  apr             Decimal  @db.Decimal(6, 4)
  minimumPayment  Decimal  @db.Decimal(12, 2)
  dueDay          Int
  creditLimit     Decimal? @db.Decimal(14, 2)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([userId])
}

enum PayoffStrategy {
  minimum
  snowball
  avalanche
  custom
}

model PayoffScenario {
  id            String         @id @default(cuid())
  userId        String
  name          String
  strategy      PayoffStrategy
  extraMonthly  Decimal        @db.Decimal(12, 2) @default(0)
  oneTimePayment Decimal       @db.Decimal(12, 2) @default(0)
  startMonth    String         // 'YYYY-MM'
  customOrder   String[]       @default([])
  /// R4.7: scheduled lump sums, each optionally targeted at a specific debt.
  /// [{month: number, amount: number, debtId?: string}]
  lumpSums      Json           @default("[]")
  createdAt     DateTime       @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]

  @@index([userId])
}

enum HouseholdRole {
  owner
  member
}

enum HouseholdInviteStatus {
  pending
  accepted
  expired
}

/// A user belongs to at most one household in v1 — enforced at the
/// create/accept step (lib/household.ts), not by the schema.
model Household {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner   User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  invites HouseholdInvite[]
  budgets Budget[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model HouseholdInvite {
  id              String                @id @default(cuid())
  householdId     String
  email           String
  token           String                @unique
  status          HouseholdInviteStatus @default(pending)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime              @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
}

enum LoanScenarioKind {
  car
  general
}

model LoanScenario {
  id              String           @id @default(cuid())
  userId          String
  name            String
  preferred       Boolean          @default(false)
  kind            LoanScenarioKind
  vehiclePrice    Decimal          @db.Decimal(14, 2) @default(0)
  downPayment     Decimal          @db.Decimal(14, 2) @default(0)
  tradeInValue    Decimal          @db.Decimal(14, 2) @default(0)
  tradeInOwed     Decimal          @db.Decimal(14, 2) @default(0)
  rebate          Decimal          @db.Decimal(14, 2) @default(0)
  taxRate         Decimal          @db.Decimal(6, 4)  @default(0)
  docFee          Decimal          @db.Decimal(12, 2) @default(0)
  registrationFee Decimal          @db.Decimal(12, 2) @default(0)
  destinationFee  Decimal          @db.Decimal(12, 2) @default(0)
  dealerFees      Decimal          @db.Decimal(12, 2) @default(0)
  loanAmount      Decimal          @db.Decimal(14, 2) @default(0)
  apr             Decimal          @db.Decimal(6, 4)
  termMonths      Int
  startDate       DateTime         @db.Date
  extraMonthly    Decimal          @db.Decimal(12, 2) @default(0)
  oneTimePayment  Decimal          @db.Decimal(12, 2) @default(0)
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum GoalType {
  emergency
  vacation
  vehicle
  home
  education
  wedding
  purchase
  custom
}

enum GoalPriority {
  low
  medium
  high
}

enum GoalStatus {
  on_track
  behind
  completed
  paused
}

model Goal {
  id                  String       @id @default(cuid())
  userId              String
  accountId           String?
  scenarioId          String?      @unique
  name                String
  type                GoalType
  targetAmount        Decimal      @db.Decimal(14, 2)
  currentAmount       Decimal      @db.Decimal(14, 2) @default(0)
  targetDate          DateTime     @db.Date
  monthlyContribution Decimal      @db.Decimal(12, 2) @default(0)
  priority            GoalPriority @default(medium)
  status              GoalStatus   @default(on_track)
  notes               String?
  createdAt           DateTime     @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// The payoff scenario this goal was auto-generated from (R11.2). SetNull,
  /// not Cascade — deleting the scenario shouldn't delete a goal the user may
  /// have kept contributing to.
  scenario      PayoffScenario?   @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id     String   @id @default(cuid())
  goalId String
  date   DateTime @db.Date
  amount Decimal  @db.Decimal(12, 2)
  note   String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

/// A position the user owns (shares + cost basis) — distinct from Watchlist,
/// which is a client-only (Zustand) list of tickers being followed, no
/// ownership implied. Quotes come from services/stocks.ts (mocked; its own
/// header comment already notes it's structured for a real provider to
/// replace later), so this model only ever stores what the user entered.
model Holding {
  id         String   @id @default(cuid())
  userId     String
  accountId  String?
  ticker     String
  shares     Decimal  @db.Decimal(16, 6)
  costBasis  Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum RecurringCadence {
  weekly
  biweekly
  monthly
  annual
}

/// Detection itself is stateless — GET /api/recurring re-runs
/// lib/finance/recurring.ts fresh over the caller's transactions every time,
/// same philosophy as reports. This table only persists what the user
/// explicitly decided (confirmed a series, or dismissed one so it stops
/// resurfacing), keyed by the same normalized payee the detector groups by.
model RecurringSeries {
  id           String            @id @default(cuid())
  userId       String
  payeeNorm    String
  cadence      RecurringCadence
  confirmed    Boolean           @default(false)
  dismissedAt  DateTime?
  createdAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payeeNorm])
  @@index([userId])
}

enum MatchType {
  contains
  equals
  regex
}

model CategorizationRule {
  id         String    @id @default(cuid())
  userId     String
  matchType  MatchType
  pattern    String
  categoryId String
  priority   Int       @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

/// R2.2: saves a CSV column mapping per institution so re-imports from the
/// same bank are one click instead of re-mapping columns every time.
model ImportMapping {
  id          String   @id @default(cuid())
  userId      String
  institution String
  mapping     Json
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institution])
  @@index([userId])
}
